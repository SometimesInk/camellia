{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CAMELLIA_REGISTER_PACKAGE": "OFF"
      }
    },
    {
      "name": "export",
      "displayName": "Export",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CAMELLIA_REGISTER_PACKAGE": "ON",
        "CMAKE_EXPORT_PACKAGE_REGISTRY": "ON"
      }
    }
  ]
}
